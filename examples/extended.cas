; The extended operations. Each one is a single instruction on a machine that
; has it, and expands into ordinary CommonASM on a machine that does not, so
; the same source runs everywhere and is fast where the hardware allows.
;
;   commonasmc examples/extended.cas --target aarch64-gnu   -> clz, rev, ror
;   commonasmc examples/extended.cas --target riscv64-zbb   -> cpop, clz, rev8
;   commonasmc examples/extended.cas --target riscv64-gnu   -> expanded
;
; Run commonasmc --target-info TARGET to see which are native there, and pass
; --emulate-extended to expand them even on a target that has them.

const stdout = 1

.data
msg: string "extended ops\n"

.text
global _start

_start:
  ; kept inside 32 bits so the example also builds for the 32-bit targets
  mov r0, 0x89abcdef

  ; how many bits are set
  mov r1, r0
  popcnt r1

  ; where the highest and lowest set bits are
  mov r2, r0
  clz r2
  mov r3, r0
  ctz r3

  ; byte order
  mov r4, r0
  bswap r4

  ; rotations, by a constant and by a register
  mov r5, r0
  rol r5, 13
  mov r6, r0
  mov r7, 13
  ror r6, r7

  ; the comparing ones, which are signed. min and max take a register or an
  ; immediate; abs leaves the most negative value alone, since negating it
  ; would not fit.
  mov r8, r0
  mov r9, 1000
  min r8, r9
  mov r10, r0
  max r10, 1000
  mov r11, r0
  abs r11

  ; sel reads its condition from the destination and replaces it with one of
  ; the two arms, so a branch is not needed to choose between two values.
  mov r12, r0
  and r12, 1
  sel r12, r8, r10

  syscall write, stdout, msg, msg_len
  syscall exit, 0
