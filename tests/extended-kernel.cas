; Compiled and linked against tests/extended-driver.c, which feeds inputs in
; and checks the results against its own implementations. This is how the
; extended operations are checked by running them rather than by reading them:
; the same source is built twice, once letting the target use its instructions
; and once with --emulate-extended forcing the expansions, and both have to
; agree with the reference.

.data
cas_in: qword 0
cas_popcnt: qword 0
cas_clz: qword 0
cas_ctz: qword 0
cas_bswap: qword 0
cas_rol: qword 0
cas_ror: qword 0
cas_rol_reg: qword 0
cas_ror_reg: qword 0
cas_inline: qword 0
cas_min: qword 0
cas_max: qword 0
cas_min_imm: qword 0
cas_abs: qword 0
cas_sel_true: qword 0
cas_sel_false: qword 0

.text
global cas_run
global cas_in
global cas_popcnt
global cas_clz
global cas_ctz
global cas_bswap
global cas_rol
global cas_ror
global cas_rol_reg
global cas_ror_reg
global cas_inline
global cas_min
global cas_max
global cas_min_imm
global cas_abs
global cas_sel_true
global cas_sel_false

func cas_run
  load.q r0, [cas_in]
  popcnt r0
  store.q [cas_popcnt], r0

  load.q r0, [cas_in]
  clz r0
  store.q [cas_clz], r0

  load.q r0, [cas_in]
  ctz r0
  store.q [cas_ctz], r0

  load.q r0, [cas_in]
  bswap r0
  store.q [cas_bswap], r0

  load.q r0, [cas_in]
  rol r0, 13
  store.q [cas_rol], r0

  load.q r0, [cas_in]
  ror r0, 13
  store.q [cas_ror], r0

  ; the same rotations with the distance in a register, which takes a
  ; different path in every backend
  load.q r0, [cas_in]
  mov r1, 13
  rol r0, r1
  store.q [cas_rol_reg], r0

  load.q r0, [cas_in]
  mov r1, 13
  ror r0, r1
  store.q [cas_ror_reg], r0

  ; Inline assembly, checked by running it: each arm multiplies by three the
  ; way its machine does best, and the last arm is CommonASM for everything
  ; without a hand-written one. {r0} is whatever the compiler put r0 in.
  load.q r0, [cas_in]
  asm x86_64 {
    lea {r0}, [{r0} + {r0} * 2]
  }
  asm aarch64 {
    add {r0}, {r0}, {r0}, lsl #1
  }
  asm arm32 {
    add {r0}, {r0}, {r0}, lsl #1
  }
  asm portable {
    mov r1, 3
    mul r0, r1
  }
  store.q [cas_inline], r0

  ; The comparing operations. The second operand is negated so that the two
  ; are on opposite sides of zero for most inputs and the signed comparison
  ; is what decides, rather than the input happening to be small.
  load.q r0, [cas_in]
  load.q r1, [cas_in]
  neg r1
  min r0, r1
  store.q [cas_min], r0

  load.q r0, [cas_in]
  load.q r1, [cas_in]
  neg r1
  max r0, r1
  store.q [cas_max], r0

  ; and once against an immediate rather than a register
  load.q r0, [cas_in]
  min r0, 1000
  store.q [cas_min_imm], r0

  load.q r0, [cas_in]
  abs r0
  store.q [cas_abs], r0

  ; sel reads its condition from the destination, so the same input picks
  ; one arm here and the other one after it is forced to zero
  load.q r0, [cas_in]
  mov r1, 111
  mov r2, 222
  sel r0, r1, r2
  store.q [cas_sel_true], r0

  mov r0, 0
  mov r1, 111
  mov r2, 222
  sel r0, r1, r2
  store.q [cas_sel_false], r0

  ret
endfunc
